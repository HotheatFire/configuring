<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShwePan" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/wood</item>
        <item name="android:statusBarColor">@color/wood</item>
        <item name="android:navigationBarColor">@color/wood</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.ShwePan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wood</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ShwePan</item>
    </style>
</resources>
